# Optional for local mode. Set a real project ID for Vertex mode.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Authoritative Brain source from TaskTree's Supabase memory service.
# TASKTREE_DATABASE_URL=postgresql://readonly-user:password@host:5432/postgres?sslmode=require
BRAIN_WORKSPACE_ID=demo-workspace

# local | rag | vertex. Local is the default; vertex requires explicit approval.
VECTOR_STORE_BACKEND=local
SQLITE_PATH=data/brain-rag.sqlite3
RAG_CORPUS_NAME=
RAG_LOCATION=us-central1
RAG_STAGING_BUCKET=

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GENERATION_MODEL=gemini-3-flash-preview
FALLBACK_MODEL=gemini-3.1-pro-preview
JUDGE_MODEL=gemini-3.1-flash-lite
ENABLE_CONTEXT_CACHE=true
MAX_OUTPUT_TOKENS=800
MAX_QUERY_COST_USD=0.05

# Required only for VECTOR_STORE_BACKEND=vertex. No endpoint is created by the app.
VERTEX_INDEX_NAME=
VERTEX_INDEX_ENDPOINT_NAME=
VERTEX_DEPLOYED_INDEX_ID=
VERTEX_VECTOR_LOCATION=us-central1
VERTEX_METADATA_COLLECTION=brain_rag_chunks
